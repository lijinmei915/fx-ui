    { "id": "thirdparty", "label": "第三方图标库", "rule": "按需引入其它库时，仍在 src/lib/icons.ts 统一映射出口；source 记为 thirdparty:<库名>。当前未接入。" },
    { "id": "custom", "label": "上传/自定义", "rule": "SVG 组件放 src/lib/icons-custom.tsx（currentColor + viewBox 0 0 24 24），从 icons.ts re-export。" }
