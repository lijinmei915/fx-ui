      "intent": ["表单", "新建", "编辑"],
      "generator": "npm run gen:edit-form-page -- --name <实体名称> --slug <slug>",
      "source": "scripts/gen-edit-form-page.mjs",
      "frame": ["CrmAppShell", "EditFormBlock"],
