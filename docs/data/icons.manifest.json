{
  "schemaVersion": 1,
  "format": "fx-ui/icons-manifest",
  "updatedAt": "2026-07-22",
  "truthSource": "src/lib/icons.ts",
  "humanDoc": "docs/TOKENS.md",
  "note": "图标注册表：AI 不靠像素识别图标，靠这张表的 name + keywords 检索取用。三种来源（内置 Tabler / 第三方库 / 上传自定义）统一汇流到 @/lib/icons 出口并登记于此。check-icons.mjs 校验每个 name 都能从 @/lib/icons 解析、名字唯一、自定义图标用 currentColor。",
  "rules": [
    "调用方一律 import { XxxIcon } from \"@/lib/icons\"，不在页面里写裸 <svg> 或 <img src=*.svg>。",
    "线型/面型成对：线型默认，面型用 *FilledIcon（DEC-009）。",
    "颜色走 currentColor + text-* 语义类，不在图标内写死色值。",
    "上传第三方 SVG 必须消毒：删 <script>、on* 事件、外链 href/xlink、内联写死色值，并强制 currentColor。",
    "name 唯一、PascalCase + Icon 结尾；新增图标必须同步登记进本表，否则 check:icons 不通过。",
    "AI 选图标按 keywords 语义匹配，不靠猜名字；业务/自定义图标必须配 keywords。"
  ],
  "sources": [
    {
      "id": "tabler",
      "label": "内置 Tabler Icons",
      "pkg": "@tabler/icons-react",
      "rule": "默认来源；在 src/lib/icons.ts 用 `IconX as XIcon` 映射稳定别名。"
    },
    {
      "id": "thirdparty",
      "label": "第三方图标库",
      "rule": "按需引入其它库时，仍在 src/lib/icons.ts 统一映射出口；source 记为 thirdparty:<库名>。当前未接入。"
    },
    {
      "id": "custom",
      "label": "上传/自定义",
      "rule": "SVG 组件放 src/lib/icons-custom.tsx（currentColor + viewBox 0 0 24 24），从 icons.ts re-export。"
    }
  ],
  "styles": [
    "line",
    "fill"
  ],
  "categories": [
    "action",
    "navigation",
    "status",
    "object",
    "media",
    "editor"
  ],
