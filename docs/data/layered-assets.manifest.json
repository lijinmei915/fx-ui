  "blocks": [
    {
      "id": "crm-shell-nav",
      "name": "CRM 双层导航",
      "source": "src/components/recipes/crm-shell-nav.tsx#CrmShellNav",
      "status": "ready",
      "components": ["NavRail", "NavMenu", "NavMenuItem", "NavMenuFooter"],
      "dataContract": ["railApps", "selected", "open", "pinned", "hovered"],
      "evidence": [
        "src/components/recipes/crm-shell-nav.tsx",
        "src/components/fx/nav-menu.tsx",
        "src/pages/templates/customer-list-template.tsx"
      ],
      "acceptanceCriteria": [
        "一级应用栏和二级菜单使用现有 NavRail/NavMenu 组合，不在页面调用处重写导航结构。",
        "折叠、hover 展开、分组展开、选中和固定状态均由现有组合交互提供。",
        "替换业务时只替换已验证的应用和菜单数据，不覆盖组件视觉。"
      ]
    },
    {
      "id": "list-page-header",
      "name": "列表页标题栏",
      "source": "src/components/recipes/list-page-header.tsx#ListPageHeader",
      "status": "ready",
      "components": [
        "DropdownMenu",
        "DropdownMenuTrigger",
        "DropdownMenuContent",
        "DropdownMenuItem"
      ],
      "dataContract": ["title", "views", "view", "onViewChange", "actions"],
      "evidence": [
        "src/components/recipes/list-page-header.tsx",
        "src/pages/templates/customer-list-template.tsx",
        "docs/data/page-build-kit.manifest.json"
      ],
      "acceptanceCriteria": [
        "标题、可选视图切换和操作插槽通过 props/slot 注入，页面不复制标题栏布局。",
        "未提供 views 或 actions 时不渲染空控件，视图切换保持受控回调。",
        "组件视觉差异必须通过组件 API 或变体表达，调用处只负责布局和数据。"
      ]
    },
    {
      "id": "crm-app-shell",
      "name": "CRM 应用外壳",
      "source": "src/components/recipes/crm-app-shell.tsx",
      "status": "ready",
      "components": ["TopBar", "CrmShellNav", "WebsiteCardContainer"],
      "dataContract": [
        "children",
        "height",
        "frame",
        "topBar",
        "navigation",
        "renderChrome"
      ],
      "acceptanceCriteria": [
        "顶栏和双层导航由现有组件提供；默认完整渲染，搭建器可通过声明式 chrome slots 控制显示与直接操作。",
        "内容承载使用 WebsiteCardContainer，不能在调用页重写容器阴影。",
        "完整应用画布外壳使用 WebsiteCardContainer square shape，整体不添加圆角。",
        "外层页面画布使用 WebsiteCardContainer page tone 消费 --background；inset 工作区保持 --card 表面。"
      ]
    },
    {
      "id": "data-table",
      "name": "数据表格区块",
      "source": "src/components/recipes/data-table.tsx",
      "status": "ready",
      "components": ["Table", "Checkbox", "Button"],
      "dataContract": [
        "columns",
        "data",
        "rowKey",
        "selectable",
        "selected",
        "onSelectedChange",
        "rowActions"
      ],
      "acceptanceCriteria": [
        "列定义必须通过 Column 契约提供，不在页面中复制表头和排序逻辑。",
        "可选行状态通过 selected/onSelectedChange 受控，支持全选和半选。"
      ]
    },
    {
      "id": "list-toolbar",
      "name": "列表工具栏",
      "source": "src/components/recipes/list-toolbar.tsx",
      "status": "ready",
      "components": ["Input", "Select", "Button"],
      "dataContract": [
        "search",
        "scopes",
        "views",
        "onSearchChange",
        "onScopeChange",
        "onViewChange",
        "onFilter",
        "actions"
      ],
      "acceptanceCriteria": [
        "搜索、范围、视图和动作均为可选配置，未提供时不渲染空控件。",
        "页面调用只传入配置和回调，不复制工具栏布局。"
      ]
    },
    {
      "id": "edit-form-block",
      "name": "编辑表单区块",
      "source": "src/components/recipes/edit-form-block.tsx#EditFormBlock",
      "status": "ready",
      "components": [
        "Field",
        "Input",
        "Textarea",
        "Button",
        "WebsiteCardContainer"
      ],
      "dataContract": [
        "fields",
        "initialValues",
        "errors",
        "onValuesChange",
        "onSubmit",
        "onCancel",
        "submitting"
      ],
      "evidence": [
        "src/components/recipes/edit-form-block.tsx",
        "src/pages/templates/edit-form-block-page.tsx"
      ],
      "visualEvidence": {
        "file": "tests/visual.spec.ts",
        "testName": "EditFormBlock 页面模块"
      },
      "acceptanceCriteria": [
        "字段由 EditFormField schema 驱动，默认值和控件类型不在页面中重复拼装。",
        "提交校验集中处理 required 字段，并将焦点移动到第一个错误字段。",
        "submitting 禁用取消和提交，提交按钮展示 Spinner；dirty 状态取消前需要确认。",
        "页面容器使用 WebsiteCardContainer，页面只注入字段数据和回调。"
      ]
    },
    {
      "id": "detail-page-block",
      "name": "详情页区块",
      "source": "src/components/recipes/detail-page-block.tsx#DetailPageBlock",
      "status": "ready",
      "components": [
        "Breadcrumb",
        "Tabs",
        "Table",
        "Button",
        "WebsiteCardContainer"
      ],
      "dataContract": [
        "breadcrumbs",
        "title",
        "subtitle",
        "status",
        "actions",
        "fields",
        "tabs",
        "timeline",
        "relatedRecords",
        "onEdit"
      ],
      "evidence": [
        "src/components/recipes/detail-page-block.tsx",
        "src/pages/templates/detail-page-block-page.tsx"
      ],
      "visualEvidence": {
        "file": "tests/visual.spec.ts",
        "testName": "DetailPageBlock 页面模块"
      },
      "acceptanceCriteria": [
        "对象页头、面包屑和动作通过 props/slot 注入，页面不复制结构。",
        "字段网格、Tabs、活动时间线、关联记录和空态均由 block 统一承载。",
        "内容区使用 WebsiteCardContainer，调用方只替换对象数据和回调。"
      ]
    },
    {
      "id": "customer-list-template",
      "name": "客户列表页模板",
      "source": "src/pages/templates/customer-list-template.tsx#CustomerListTemplate",
      "status": "ready",
      "components": [
        "CrmAppShell",
        "ListPageHeader",
        "ListToolbar",
        "DataTable",
        "Pagination"
      ],
      "evidence": [
        "src/pages/templates/customer-list-template.tsx",
        "scripts/gen-list-page.mjs"
      ],
      "dataContractSource": "docs/data/page-build-kit.manifest.json#list",
      "dataContract": ["columns", "rows", "views", "scopes", "rowActions"],
      "visualEvidence": {
        "file": "tests/visual.spec.ts",
        "testName": "客户列表页模板"
      },
      "acceptanceCriteria": [
        "页面外壳由 CrmAppShell 提供，内容区只注入列表页数据和受控回调。",
        "列表必须支持搜索范围、视图切换、可选行和分页状态。",
        "搭建模式下的区块 hover、focus 和选中态使用内容上层的 primary 2px 内描边，顶边使用独立上层标记避免被相邻区块遮挡，不改变区块尺寸或真实页面视觉。",
        "完成后通过 check:page-build-kit、check:layered-assets 和客户列表视觉回归。"
      ]
    },
    {
      "id": "page-builder",
      "name": "受控页面搭建器",
      "source": "src/components/recipes/page-builder.tsx#PageBuilder",
      "status": "ready",
      "components": [
        "Card",
        "Button",
        "Input",
        "Select",
        "ToggleGroup",
        "Separator",
        "ComponentPlayground"
      ],
      "dataContractSource": "docs/data/page-builder.manifest.json",
      "dataContract": [
        "template",
        "slots",
        "properties",
        "presets",
        "value",
        "onValueChange",
        "renderPreview"
      ],
      "evidence": [
        "src/components/recipes/page-builder.tsx",
        "src/components/recipes/component-builder.tsx",
        "src/pages/docs/governance/page-builder-page.tsx",
        "docs/data/page-builder.manifest.json"
      ],
      "visualEvidence": {
        "file": "tests/visual.spec.ts",
        "testName": "页面搭建器客户列表 MVP"
      },
      "acceptanceCriteria": [
        "运行时只渲染 manifest 声明的模板、slot 和 Block，不执行 JSX 或 CSS 输入。",
        "未知或重复 slot、非法 enum 属性会被归一化；必需 slot 始终存在。",
        "区块排序通过可访问的上移、下移操作完成，删除操作尊重 required 约束。",
        "预览设备切换位于搭建器顶栏中部，预览画布不再保留重复的标题工具行。",
        "搭建器顶栏使用 --card 白色表面和 --border-subtle 底部细分割线，页面预览画布才使用 --background 全局页面背景。"
      ]
    },
    {
      "id": "component-builder",
      "name": "受控基础组件评审台",
      "source": "src/components/recipes/component-builder.tsx#ComponentBuilder",
      "status": "ready",
      "components": [
        "Button",
        "Checkbox",
        "Field",
        "Input",
        "ScrollArea",
        "Select",
        "Separator",
        "Spinner",
        "Tag",
        "Alert",
        "Textarea"
