      "dataContractSource": "docs/data/page-builder.manifest.json#component",
      "dataContract": [
        "external Agent candidate contract",
        "governed preview adapter",
        "real API controls",
        "runtime property review",
        "governance checks",
        "revision task",
        "candidate approval",
        "undo",
        "redo"
