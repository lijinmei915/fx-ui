    "check:shadcn": "node scripts/check-shadcn-contract.mjs",
    "check:tokens": "bash scripts/check-tokens-sync.sh",
    "check:foundation-tokens": "node scripts/check-foundation-tokens.mjs",
    "check:fds-foundation": "node scripts/build-fds-foundation.mjs --check",
    "check:fds-semantic": "node scripts/build-fds-semantic.mjs --check",
    "check:fds-components": "node scripts/build-fds-components.mjs --check",
    "check:token-naming": "node scripts/check-token-naming.mjs",
    "check:fds-migration": "node scripts/build-fds-migration-audit.mjs --check",
    "check:theme": "node scripts/check-theme-contract.mjs",
    "check:theme-presets": "node scripts/check-theme-presets.mjs",
    "check:theme-artifacts": "node scripts/build-theme-artifacts.mjs --check",
    "check:theme-audit": "node scripts/build-theme-audit.mjs --check",
    "check:theme-release": "node scripts/build-theme-release.mjs --check",
    "check:agent-tokens": "node scripts/build-agent-token-contract.mjs --check",
    "check:agent-components": "node scripts/build-agent-components.mjs --check",
    "check:framework-core": "node scripts/build-framework-core.mjs --check",
    "check:agent-query": "node scripts/check-agent-query-contract.mjs",
    "check:agent-examples": "node scripts/check-agent-examples.mjs",
    "check:agent-recipes": "node scripts/check-agent-recipes.mjs",
    "check:page-build-kit": "node scripts/check-page-build-kit.mjs",
    "check:page-semantics": "node scripts/check-page-semantics.mjs",
    "check:page-builder": "node scripts/check-page-builder.mjs",
    "check:layered-assets": "node scripts/check-layered-assets.mjs",
    "check:doc-site": "node scripts/check-doc-site-contract.mjs",
    "check:publication-profiles": "node scripts/check-publication-profiles.mjs",
    "check:components": "node scripts/check-components-manifest.mjs",
    "check:component-quality": "node scripts/build-component-quality.mjs --check",
    "check:playground": "node scripts/check-playground-contract.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "build:icons": "node scripts/build-icons-manifest.mjs",
    "check:agent-ui": "node scripts/check-agent-ui-contract.mjs",
    "check:all": "bash scripts/check-all.sh",
    "build:tokens": "node scripts/build-fds-foundation.mjs && node scripts/build-fds-semantic.mjs && node scripts/build-fds-components.mjs && node scripts/build-design-tokens.mjs && node scripts/build-agent-token-contract.mjs",
    "build:fds-foundation": "node scripts/build-fds-foundation.mjs",
    "build:fds-semantic": "node scripts/build-fds-semantic.mjs",
    "build:fds-components": "node scripts/build-fds-components.mjs",
    "build:fds-migration-audit": "node scripts/build-fds-migration-audit.mjs",
    "build:theme-artifacts": "node scripts/build-theme-artifacts.mjs",
    "build:theme-audit": "node scripts/build-theme-audit.mjs",
    "build:theme-release": "node scripts/build-theme-release.mjs",
    "build:quality": "node scripts/build-component-quality.mjs",
    "tokens": "node scripts/token-agent.mjs",
    "build:agent": "node scripts/build-agent-components.mjs && node scripts/build-agent-context.mjs",
    "build:framework-core": "node scripts/build-framework-core.mjs",
    "fx": "node scripts/fx-agent.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build:governance-pages": "node scripts/build-governance-pages.mjs",
    "preview": "vite preview",
    "preview:foundation": "vite preview --outDir dist-foundation",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:foundation": "playwright test --config playwright.foundation.config.ts",
    "test:visual:foundation:update": "playwright test --config playwright.foundation.config.ts --update-snapshots",
    "gen:list-page": "node scripts/gen-list-page.mjs",
    "gen:edit-form-page": "node scripts/gen-edit-form-page.mjs",
    "gen:detail-page": "node scripts/gen-detail-page.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@lijinmei-810/dev-inspector": "^0.2.1",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
