  "componentPlayground": {
    "componentKey": "button",
    "componentName": "Button",
    "route": "#button",
    "source": "src/components/ui/button.tsx",
    "truthSource": "Button 页调试台结构",
    "rulePanel": {
      "sections": [
        "values",
        "sources"
      ],
      "sources": [
        {
          "label": "源码",
          "value": "src/components/fx/component-playground.tsx"
