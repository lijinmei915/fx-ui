{
  "schemaVersion": 1,
  "format": "fx-ui/layered-assets",
  "policy": "Only verified local sources may be exposed as a layer. A pattern or block must point to an existing recipe/source; a page template must point to a declared build-kit archetype.",
  "layers": ["components", "hooks", "patterns", "blocks", "page-templates"],
  "components": {
    "sources": [
      {
        "id": "shadcn-ui",
        "path": "src/components/ui",
        "contract": "docs/data/components.manifest.json",
        "status": "ready"
      },
      {
        "id": "fx-components",
        "path": "src/components/fx",
        "contract": "docs/data/components.manifest.json",
        "status": "ready"
      }
    ]
  },
  "hooks": [
    {
      "id": "use-mobile",
      "name": "useIsMobile",
      "source": "src/hooks/use-mobile.ts",
      "intent": ["移动端断点", "responsive", "mobile viewport"],
      "status": "ready",
      "evidence": ["src/hooks/use-mobile.ts", "src/components/ui/sidebar.tsx"],
      "constraints": ["只负责 viewport 判断，不承载页面布局或组件视觉。"]
    }
  ],
  "patterns": [
    {
      "id": "email-field-validation",
      "name": "邮箱字段校验",
