        },
        {
          "label": "真相源",
          "value": "docs/data/component-playgrounds.manifest.json"
        }
      ]
    },
    "rules": [
      {
        "title": "先分场景，再分属性",
        "value": "scenario → props",
        "logic": "场景用于表达“这是哪一类典型用法”（如基础 / 交互 / 高级）；属性用于表达“同一类用法内可调的参数”（如尺寸 / 密度 / 图标位置）。"
      },
      {
        "title": "场景必须是成形用法",
        "value": "stable scenario",
        "logic": "能独立回答用户‘什么时候这样用’的，才配叫场景；单纯数值切换、视觉强度、尺寸差异，不单列为场景。"
      },
      {
        "title": "先问‘何时用’，再问‘怎么调’",
        "value": "intent first",
        "logic": "如果这个切换项回答的是‘我现在处于哪类业务模式’，它属于场景；如果回答的是‘这类模式里的某个参数怎么调’，它属于属性。"
      },
      {
        "title": "属性必须映射源码 API",
        "value": "real API",
        "logic": "属性项优先对应组件真实 prop 或稳定可派生能力；不要发明页面私有开关。"
      },
      {
        "title": "调试内容来自统一真相源",
        "value": "manifest SSOT",
        "logic": "组件调试台的场景、属性、意图和约束收口到 docs/data/component-playgrounds.manifest.json；网站规范只展示这份事实，组件页读取同一份事实后渲染真实组件。"
      },
      {
        "title": "同级不混",
        "value": "no mixed level",
        "logic": "不要把“基础 / 高级”和“行高 / 图标位置 / 尺寸”放在一排同级按钮里，否则用户会分不清这是模式切换还是参数切换。"
      },
      {
        "title": "一个场景里允许多个属性",
        "value": "multiple props",
        "logic": "场景数量应保持少而稳；密度、尺寸、图标位置、对齐方式这类可连续复用的变化，应该挂在当前场景下面做实时属性，而不是继续横向加场景标签。"
      },
      {
        "title": "实时属性统一算属性",
        "value": "Interactive props",
        "logic": "只要控件被放进“实时属性 / Interactive props”分组，它就统一表达当前场景下的可调参数；不要把其中某一项再当成并列场景解释。"
      }
    ]
  },
