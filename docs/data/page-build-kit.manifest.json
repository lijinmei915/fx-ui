      "frame": ["CrmAppShell", "ListPageHeader", "ListToolbar", "DataTable", "Pagination"],
      "dataContract": ["columns", "rows", "views", "scopes", "rowActions"],
      "constraints": ["生成后只填 columns、rows 和受控配置。", "路由登记 pageRegistry 与 docsNav。", "完成后运行 check:all 与 test:visual。"]
    },
    {
